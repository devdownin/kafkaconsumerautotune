# Le Dockerfile ne copie que pom.xml et src/, mais tout le reste du contexte
# est transféré au démon à chaque build et invalide le cache inutilement.

.git
.github
.mvn/wrapper/maven-wrapper.jar
target/
logs/
*.log

# Documentation et site vitrine : sans effet sur l'image produite.
docs/
static-site/
grafana/
*.md

# Pile de démonstration locale.
docker-compose.yml
prometheus.yml
prometheus-rules.yml
promtail-config.yaml
otel-collector-config.yaml
init.sql

# node_modules est réinstallé dans l'image par frontend-maven-plugin ; le
# transférer ne ferait qu'alourdir le contexte. package.json, package-lock.json
# et tailwind.config.js sont en revanche nécessaires à la compilation du CSS.
node_modules/

# Environnements de développement.
.idea/
.vscode/
*.iml
