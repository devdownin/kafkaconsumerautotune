<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Standard Console Appender for development -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>utf8</charset>
        </encoder>
    </appender>

    <springProperty scope="context" name="appName" source="spring.application.name"/>

    <!-- JSON Console Appender for production/cloud environments (ELK format) -->
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <fieldName>@timestamp</fieldName>
                    <timeZone>UTC</timeZone>
                </timestamp>
                <pattern>
                    <pattern>
                        {
                          "event": {
                            "category": "%mdc{eventCategory:-web}",
                            "kind": "event",
                            "outcome": "%mdc{eventOutcome:-success}",
                            "type": "%mdc{eventType:-access}"
                          },
                          "correlation": {
                            "id": "%mdc{correlationId}"
                          },
                          "log": {
                            "level": "%level",
                            "logger": "%logger",
                            "rgpd": "%mdc{rgpd:-false}",
                            "authentication": "%mdc{authentication}"
                          },
                          "message": "%message",
                          "organization": {
                            "service": {
                              "id": "USR-SVC-001",
                              "application": "${appName:-kafka-consumer-batch-service}",
                              "version": "1.0.0"
                            }
                          }
                        }
                    </pattern>
                </pattern>
                <stackTrace>
                    <fieldName>stack_trace</fieldName>
                </stackTrace>
            </providers>
        </encoder>
    </appender>

    <!-- Profile: dev and local-h2 use standard human-readable logs -->
    <springProfile name="dev, local-h2">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- Profile: rec (and any others like prod) use structured JSON logs -->
    <springProfile name="!dev &amp; !local-h2">
        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
        </root>
    </springProfile>

    <!-- Loggers configuration -->
    <logger name="com.vaut" level="INFO"/>
    <logger name="org.springframework.kafka" level="INFO"/>
    <logger name="org.apache.kafka" level="WARN"/>

</configuration>
